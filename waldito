#!/usr/bin/env python3
"""waldito -- generate and drive tiny, Ollama-exportable openwaldo domain models.

Each domain gets a fixed name, waldito-<domain>, and a generated compose,
waldito-<domain>.yaml. Sizes are WALDO's own preset ladder (internal/model/
presets.go: 10m/35m/90m) plus a smaller 1m rung for fast pipeline runs.

Byte tokenizer, not subword: it's the only vocabulary GGUF export reaches
Ollama with today (internal/modelexport/gguf.go). ADR 0046 calls byte-level
inferior to subword -- a workaround for an export gap, not a recommendation.

    waldito catalog                            # languages and repo counts
    waldito catalog typescript                 # the repos themselves
    waldito new vue --lang vue                 # one language
    waldito new web --lang typescript,vue      # or several
    waldito train vue
    waldito export vue
    waldito status
"""
import argparse
import collections
import getpass
import json
import os
import shutil
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
WALDO_BIN = REPO_ROOT / "bin" / "waldo"

# Beside ~/.waldo/models and ~/.waldo/index, not the repo tree -- never needs a .gitignore entry.
WALDITO_DIR = Path.home() / ".waldo" / "waldito"

COMMAND_COLOR = "\033[1;36m"  # bold cyan, distinct from waldo's own output
FRAME_COLOR = "\033[2;32m"  # dim green, so the starting/finished bookends recede
RESET_COLOR = "\033[0m"

# name -> (context_tokens, hidden_size, intermediate_size, layers, attention_heads,
#          key_value_heads, batch_size). 10m/35m/90m match internal/model/presets.go;
#          1m is an extra fast-pipeline rung (WALDO enforces no minimum size).
SIZES = {
    "1m": (512, 128, 384, 4, 4, 2, 32),
    "10m": (512, 384, 1024, 6, 6, 2, 32),
    "35m": (1024, 512, 1408, 12, 8, 2, 16),
    "90m": (2048, 768, 2048, 12, 12, 4, 8),
}
DEFAULT_SIZE = "1m"  # smallest rung: the Mac case is getting through the pipeline fast

# The byte tokenizer's fixed vocabulary: 256 byte values plus pad/bos/eos.
VOCABULARY_SIZE = 259

# The corpus waldito draws from -- permissive licensing only, so any model built here is safe to pass around.
CATALOG_CORPUS = "code/permissive"

# Whole tuning surface not on the command line; hand-edit the generated .yaml for more.
# warmup_steps/checkpoint_every/evaluate_every are omitted, not defaulted: a fixed guess
# can fail before the real step count is known, so WALDO derives them at preflight
# instead (internal/training/profile.go).
TRAINING_DEFAULTS = {
    "seed": 7,
    "learning_rate": 0.0003,
}

COMPOSE_TEMPLATE = """\
# Waldito: tiny, locally-runnable openwaldo domain model. Generated by
# `./waldito new {domain}` -- see docs/MODEL-COMPOSE.md for the schema.
# Byte tokenizer: the only vocabulary GGUF export reaches Ollama with today
# (internal/modelexport/gguf.go); ADR 0046 calls it inferior to subword.
kind: waldo-model-compose
schema: 1
interaction:
  template: user-assistant-v1
architecture:
  family: decoder-transformer
  context_tokens: {context_tokens}
  vocabulary_size: {vocabulary_size}
  hidden_size: {hidden_size}
  intermediate_size: {intermediate_size}
  layers: {layers}
  attention_heads: {attention_heads}
  key_value_heads: {key_value_heads}
  tie_embeddings: true
  parameter_dtype: bfloat16
  tokenizer:
    name: byte
    revision: builtin-byte-schema-1
stages:
  - name: pretrain
    type: pre-training
    objective: causal-language-modeling
    filter:
      main_content: true
      exclude:
        repetitive_content: true
        boilerplate_content: true
{sources_block}    corpora:
      - path: "{corpus}"
        weight: 1
    parameters:
      # epochs, not tokens: budget -- WALDO derives exact steps from the real corpus
      # at preflight (ADR 0059). Above 1, epochs re-read the same tokens; useful
      # when the corpus is too small to fill the model once, with fast diminishing returns.
      profile: causal-pretrain-weighted
      epochs: {epochs}
      batch_size: {batch_size}
      sequence_length: {context_tokens}
      learning_rate: {learning_rate}
      seed: {seed}
      weight_decay: 0.1
      shuffle_buffer_records: 65536
      shuffle_buffer_bytes: 2147483648
      evaluation_max_records: 1024
      evaluation_max_bytes: 33554432
"""

SOURCES_BLOCK_TEMPLATE = """\
      sources:
        include:
{repo_lines}
"""


def model_name(domain):
    return f"waldito-{domain}"


def compose_path(domain):
    return WALDITO_DIR / f"waldito-{domain}.yaml"


def export_dir(domain):
    return WALDITO_DIR / "export" / f"{model_name(domain)}-ollama"


def format_duration(seconds):
    """Clone of waldo's compactDuration (internal/cli/model.go), for matching output."""
    seconds = int(seconds)
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


def catalog():
    """Repos in CATALOG_CORPUS by lowercased language, plus corpus totals --
    derived from the index every call, so nothing here can go stale."""
    corpora = waldo_json("index", "list")["corpora"]
    entry = next((corpus for corpus in corpora if corpus["path"] == CATALOG_CORPUS), None)
    if entry is None:
        print(f"{CATALOG_CORPUS} is not in the index", file=sys.stderr)
        sys.exit(1)
    manifest = waldo_json("index", "show", entry["manifest"])
    languages = collections.defaultdict(list)
    for source in manifest["sources"]:
        # Case-folded: the index carries both "Shell" and "shell".
        for language in source.get("content", {}).get("programming_languages", []):
            languages[language.lower()].append(source["name"])
    tokens = sum(shard["tokens"] for shard in manifest["shards"])
    return languages, tokens, len(manifest["sources"])


def prompt(cwd):
    """user@host:~/path style prefix, matching a real shell prompt."""
    user = os.environ.get("USER") or getpass.getuser()
    host = socket.gethostname().split(".")[0]
    home = str(Path.home())
    here = str(Path(cwd).resolve())
    if here == home:
        path = "~"
    elif here.startswith(home + os.sep):
        path = "~" + here[len(home):]
    else:
        path = here
    return f"{user}@{host}:{path}>"


def show_command(argv, cwd=REPO_ROOT):
    # Prefix colored like a shell prompt; the command stays default, since it's the real output.
    print(f"{COMMAND_COLOR}{prompt(cwd)}{RESET_COLOR} {' '.join(argv)}")


def run(argv, cwd=REPO_ROOT, env=None):
    """Prints the command, streams output live, raises on non-zero exit."""
    show_command(argv, cwd)
    subprocess.run(argv, cwd=cwd, env=env, check=True)


def build_waldo():
    run(["go", "build", "-o", str(WALDO_BIN), "./cmd/waldo"])


def run_waldo(*args):
    run([str(WALDO_BIN), *args])


def waldo_json(*args):
    # check=True: a failure raises instead of silently reading as "no models yet".
    # stderr stays inherited so waldo's own error reaches the terminal.
    argv = [str(WALDO_BIN), "--json", *args]
    show_command(argv)
    result = subprocess.run(argv, cwd=REPO_ROOT, stdout=subprocess.PIPE, text=True, check=True)
    return json.loads(result.stdout) if result.stdout.strip() else []


def cmd_new(args):
    path = compose_path(args.domain)
    if path.exists() and not args.force:
        # Printed here, not via sys.exit(str): that only prints once SystemExit
        # reaches main()'s finally block, which would print "finished" first.
        print(f"{path} already exists; pass --force to overwrite", file=sys.stderr)
        sys.exit(1)
    if args.epochs < 1:
        print("--epochs must be 1 or more", file=sys.stderr)
        sys.exit(1)
    context_tokens, hidden_size, intermediate_size, layers, attention_heads, key_value_heads, batch_size = SIZES[args.size]
    # --repos stays alongside --lang: index language tags don't always match the
    # name (vuejs/vue is tagged TypeScript), so --lang alone can't reach every repo.
    repos = [repo.strip() for repo in args.repos.split(",") if repo.strip()]
    if args.lang:
        languages, _, _ = catalog()
        # Comma-separated, because one language is rarely the whole domain.
        wanted = [name.strip().lower() for name in args.lang.split(",") if name.strip()]
        missing = [name for name in wanted if name not in languages]
        if missing:
            print(f"no {', '.join(missing)} repos in {CATALOG_CORPUS}; "
                  f"`waldito catalog` lists what is there", file=sys.stderr)
            sys.exit(1)
        # Deduplicated: a repo declaring both typescript and vue is one repo.
        repos = sorted(set(repos) | {repo for name in wanted for repo in languages[name]})
        print(f"{len(repos)} repo{'' if len(repos) == 1 else 's'} from {', '.join(wanted)}")
    sources_block = ""
    if repos:
        # Quoted: an unquoted " #" would truncate as a YAML comment, and a
        # leading *, &, [ or { is alias/anchor/flow syntax rather than text.
        repo_lines = "\n".join(f'          - "{repo}"' for repo in repos)
        sources_block = SOURCES_BLOCK_TEMPLATE.format(repo_lines=repo_lines)
    compose = COMPOSE_TEMPLATE.format(
        domain=args.domain, context_tokens=context_tokens, hidden_size=hidden_size,
        intermediate_size=intermediate_size, layers=layers, attention_heads=attention_heads,
        key_value_heads=key_value_heads, sources_block=sources_block, corpus=args.corpus,
        batch_size=batch_size, vocabulary_size=VOCABULARY_SIZE, epochs=args.epochs, **TRAINING_DEFAULTS,
    )
    WALDITO_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(compose)
    print(f"wrote {path}")


def cmd_catalog(args):
    """With no language, the menu of what CATALOG_CORPUS holds; with one, the repos themselves."""
    languages, corpus_tokens, corpus_repos = catalog()
    if args.language:
        repos = languages.get(args.language.lower())
        if not repos:
            print(f"no {args.language} repos in {CATALOG_CORPUS}; `waldito catalog` lists what is there", file=sys.stderr)
            sys.exit(1)
        for repo in sorted(repos):
            print(repo)
        return
    # Index facts only -- no per-repo token counts exist; ingest aggregates
    # tokens per license but keeps sources as a bare set (internal/ingest/assemble.go).
    print(f"{CATALOG_CORPUS}: {corpus_repos} repos, {corpus_tokens / 1e9:.2f}B tokens")
    print(f"{'LANGUAGE':<16}{'REPOS':>6}")
    for language, repos in sorted(languages.items(), key=lambda item: -len(item[1])):
        print(f"{language:<16}{len(repos):>6}")


def cmd_train(args):
    throttle = os.environ.get("WALDO_GPU_THROTTLE")
    if throttle:
        print(f"WALDO_GPU_THROTTLE={throttle} (GPU will idle between steps to hold roughly that duty cycle)")
    name, compose = model_name(args.domain), compose_path(args.domain)
    if not compose.exists():
        print(f"{compose} does not exist; run `waldito new {args.domain}` first", file=sys.stderr)
        sys.exit(1)
    # Mitigates the macOS Metal watchdog killing MLX training with
    # kIOGPUCommandBufferCallbackErrorImpactingInteractivity when the display is
    # active (ml-explore/mlx#3267, wontfix -- an Apple-side limit). Undocumented,
    # reported to help; harmless elsewhere. Still dying with that error? Close the lid.
    env = {**os.environ, "AGX_RELAX_CDM_CTXSTORE_TIMEOUT": "1"}
    run([str(WALDO_BIN), "model", "train", name, str(compose)], env=env)
    # model chat reads weights directly, no export needed. Compare the held-out
    # loss above to ln(259)=5.56, the random-guess baseline for this vocabulary.
    print(f"\ntry it:  {WALDO_BIN} model chat {name} '<template>' --max-tokens 80")


def cmd_export(args):
    name, out = model_name(args.domain), export_dir(args.domain)
    # Always an incomplete EU GPAI draft -- a local waldito model is never placed on the EU market.
    run_waldo("model", "export", name, str(out), "--format", "ollama", "--allow-incomplete")
    run(["ollama", "create", name, "-f", "Modelfile"], cwd=out)


def cmd_delete(args):
    """Removes waldito-<domain> and any stale staged compose transaction, so the
    next new/train starts fresh instead of hitting "unfinished compose"."""
    name = model_name(args.domain)
    # waldo model rm has no confirmation of its own and takes every GPU-hour
    # trained with it. Same [y/N] wording as waldo's own confirmations (advisor.go).
    try:
        answer = input(f"waldito: delete {name} and all of its training? [y/N] ").strip().lower()
    except EOFError:
        answer = ""  # no terminal to confirm on (piped stdin) is not a yes
    if answer not in ("y", "yes"):
        print("cancelled")
        return
    argv = [str(WALDO_BIN), "model", "rm", name]
    show_command(argv)
    result = subprocess.run(argv, cwd=REPO_ROOT, capture_output=True, text=True)
    # Idempotent like rm -f: nothing to remove isn't worth showing, since waldo's
    # "no such model" otherwise surfaces as a raw MODEL.json-not-found error.
    if result.returncode == 0 and result.stdout.strip():
        print(result.stdout.strip())
    staging = Path.home() / ".waldo" / "models" / ".waldo-compose"
    if not staging.is_dir():
        return
    for transaction_dir in staging.iterdir():
        compose_json = transaction_dir / "COMPOSE.json"
        try:
            staged = json.loads(compose_json.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if staged.get("name") == name:
            shutil.rmtree(transaction_dir)
            print(f"removed stale compose transaction {transaction_dir.name}")


def cmd_status(args):
    models = waldo_json("model", "list")
    if args.domain:
        models = [entry for entry in models if entry.get("name") == model_name(args.domain)]
    else:
        models = [entry for entry in models if entry.get("name", "").startswith("waldito-")]
    if not models:
        print("no waldito models yet -- try `waldito new <domain> ...`")
        return
    for entry in models:
        # No state key at all means architecture created, nothing trained yet.
        state = entry.get("state", "no runs yet")
        print(f"{entry['name']:<28} {state:<12} {entry.get('approximate_parameters', '?')}")


def main():
    # Without this, print() fully buffers when stdout isn't a TTY, so our
    # messages can appear out of order against subprocess output.
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(prog="waldito", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    new = sub.add_parser("new", help="generate waldito-<domain>.yaml")
    new.add_argument("domain")
    new.add_argument("--corpus", default=CATALOG_CORPUS)
    new.add_argument("--lang", default="", help="comma-separated catalog languages; takes every repo of each")
    new.add_argument("--repos", default="", help="comma-separated source repos, named exactly; combines with --lang")
    new.add_argument("--size", choices=list(SIZES), default=DEFAULT_SIZE)
    new.add_argument("--epochs", type=int, default=1, help="passes over the same tokens; each extra pass buys less than the last")
    new.add_argument("--force", action="store_true")
    new.set_defaults(func=cmd_new)

    catalog_parser = sub.add_parser("catalog", help=f"what {CATALOG_CORPUS} can train on, and what it would cost")
    catalog_parser.add_argument("language", nargs="?", help="list this language's repos instead of the summary")
    catalog_parser.set_defaults(func=cmd_catalog)

    train = sub.add_parser("train", help="train waldito-<domain>")
    train.add_argument("domain")
    train.set_defaults(func=cmd_train)

    export = sub.add_parser("export", help="export waldito-<domain> to Ollama")
    export.add_argument("domain")
    export.set_defaults(func=cmd_export)

    delete = sub.add_parser("delete", help="delete waldito-<domain>, its training, and any stale compose transaction")
    delete.add_argument("domain")
    delete.set_defaults(func=cmd_delete)

    status = sub.add_parser("status", help="list waldito models and their state")
    status.add_argument("domain", nargs="?")
    status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    # "starting"/"finished" are both 8 chars, so the colons and timestamps line up.
    started = datetime.now(timezone.utc)
    print(f"{FRAME_COLOR}waldito starting: {started:%Y-%m-%d %H:%M:%S} UTC{RESET_COLOR}")
    try:
        # Once per invocation, not once per subcommand.
        build_waldo()
        args.func(args)
    except KeyboardInterrupt:
        # waldo already reports the clean interruption (retained transaction, resume hint).
        print()
        sys.exit(130)
    except FileNotFoundError as error:
        # go/ollama are external; missing one raises here instead of a traceback.
        print(f"{error.filename} is not installed or not on PATH", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    finally:
        # Runs regardless of how main() exits. Duration reuses the same two
        # timestamps being printed, so it can't disagree with them.
        finished = datetime.now(timezone.utc)
        elapsed = format_duration((finished - started).total_seconds())
        print(f"{FRAME_COLOR}waldito finished: {finished:%Y-%m-%d %H:%M:%S} UTC ({elapsed}){RESET_COLOR}")


if __name__ == "__main__":
    main()
