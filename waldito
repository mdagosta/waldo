#!/usr/bin/env python3
"""waldito -- generate and drive tiny, Ollama-exportable openwaldo topic models.

Each topic gets a fixed name, waldito-<topic>, and a generated compose,
waldito-<topic>.yaml. Sizes are WALDO's own preset ladder (internal/model/
presets.go: 10m/35m/90m) plus a smaller 1m rung for fast pipeline runs.

Byte tokenizer, not subword: it's the only vocabulary GGUF export reaches
Ollama with today (internal/modelexport/gguf.go). ADR 0046 calls byte-level
inferior to subword -- a workaround for an export gap, not a recommendation.

    waldito catalog                            # every corpus in the index (fiction, caselaw, ...)
    waldito catalog code/*                     # ...narrowed to corpora matching a glob
    waldito catalog code/* --code               # languages and repo counts merged across that glob
    waldito catalog --code                     # ...merged across every code-tagged corpus, any namespace
    waldito catalog --code --lang typescript    # the repos themselves
    waldito catalog --code --lang python,typescript   # ...tagged with either language
    waldito catalog code/permissive --code --lang typescript   # ...just within that one corpus
    waldito new vue --corpus code/permissive --lang vue                 # one corpus, one language
    waldito new web --corpus code/* --lang typescript,vue               # every code/* corpus, several languages
    waldito train vue
    waldito export vue
    waldito status
"""
import argparse
import collections
import fnmatch
import getpass
import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
# Matches the README's own `go build -o ./waldo ./cmd/waldo` -- the one build
# step every contributor already has, not a separate bin/waldo convention.
# Relative, not REPO_ROOT / "waldo": every subprocess call below runs with
# cwd=REPO_ROOT, and the prompt already shows that directory, so the
# absolute form would just repeat it on every echoed command line.
WALDO_BIN = "waldo"

# Beside ~/.waldo/models and ~/.waldo/index, not the repo tree -- never needs a .gitignore entry.
WALDITO_DIR = Path.home() / ".waldo" / "waldito"

def rgb_color(hex_color):
    """24-bit ANSI foreground escape for a #RRGGBB hex string -- exact
    brightness control, unlike the fixed 8/16-color SGR codes."""
    red, green, blue = (int(hex_color[index:index + 2], 16) for index in (0, 2, 4))
    return f"\033[38;2;{red};{green};{blue}m"


COMMAND_COLOR = "\033[2;32m"  # dim green, distinct from waldo's own output but not as loud as bold cyan
FRAME_COLOR = rgb_color("998F30")  # muted mustard yellow, classic log-warning hue without the glare
RESET_COLOR = "\033[0m"

# name -> (context_tokens, hidden_size, intermediate_size, layers, attention_heads,
#          key_value_heads, batch_size). 10m/35m/90m match internal/model/presets.go;
#          1m is an extra fast-pipeline rung (WALDO enforces no minimum size).
SIZES = {
    "1m": (512, 128, 384, 4, 4, 2, 32),
    "10m": (512, 384, 1024, 6, 6, 2, 32),
    "35m": (1024, 512, 1408, 12, 8, 2, 16),
    "90m": (2048, 768, 2048, 12, 12, 4, 8),
}

# The byte tokenizer's fixed vocabulary: 256 byte values plus pad/bos/eos.
VOCABULARY_SIZE = 259

# Whole tuning surface not on the command line; hand-edit the generated .yaml for more.
# warmup_steps/checkpoint_every/evaluate_every are omitted, not defaulted: a fixed guess
# can fail before the real step count is known, so WALDO derives them at preflight
# instead (internal/training/profile.go).
TRAINING_DEFAULTS = {
    "seed": 7,
    "learning_rate": 0.0003,
}

COMPOSE_TEMPLATE = """\
# Waldito: tiny, locally-runnable openwaldo topic model. Generated by
# `./waldito new {topic}` -- see docs/MODEL-COMPOSE.md for the schema.
# Byte tokenizer: the only vocabulary GGUF export reaches Ollama with today
# (internal/modelexport/gguf.go); ADR 0046 calls it inferior to subword.
kind: waldo-model-compose
schema: 1
interaction:
  template: user-assistant-v1
architecture:
  family: decoder-transformer
  context_tokens: {context_tokens}
  vocabulary_size: {vocabulary_size}
  hidden_size: {hidden_size}
  intermediate_size: {intermediate_size}
  layers: {layers}
  attention_heads: {attention_heads}
  key_value_heads: {key_value_heads}
  tie_embeddings: true
  parameter_dtype: bfloat16
  tokenizer:
    name: byte
    revision: builtin-byte-schema-1
stages:
  - name: pretrain
    type: pre-training
    objective: causal-language-modeling
    filter:
      main_content: true
      exclude:
        repetitive_content: true
        boilerplate_content: true
{sources_block}    corpora:
{corpora_block}
    parameters:
      # epochs, not tokens: budget -- WALDO derives exact steps from the real corpus
      # at preflight (ADR 0059). Above 1, epochs re-read the same tokens; useful
      # when the corpus is too small to fill the model once, with fast diminishing returns.
      profile: causal-pretrain-weighted
      epochs: {epochs}
      batch_size: {batch_size}
      sequence_length: {context_tokens}
      learning_rate: {learning_rate}
      seed: {seed}
      weight_decay: 0.1
      shuffle_buffer_records: 65536
      shuffle_buffer_bytes: 2147483648
      evaluation_max_records: 1024
      evaluation_max_bytes: 33554432
"""

SOURCES_BLOCK_TEMPLATE = """\
      sources:
        include:
{repo_lines}
"""


def model_name(topic):
    return f"waldito-{topic}"


def compose_path(topic):
    return WALDITO_DIR / f"waldito-{topic}.yaml"


def export_dir(topic):
    return WALDITO_DIR / "export" / f"{model_name(topic)}-ollama"


def format_duration(seconds):
    """Clone of waldo's compactDuration (internal/cli/model.go), for matching output."""
    seconds = int(seconds)
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


def code_corpora(corpora):
    """`corpora` narrowed to ones tagged with programming languages -- the
    subset --lang can search, as opposed to WALDO's non-code catalogs
    (fiction, mailing lists, caselaw, ...)."""
    return [corpus for corpus in corpora if corpus.get("programming_languages")]


def matching_corpora(corpora, pattern):
    """`corpora` (index list entries) whose path matches `pattern` by shell
    globbing -- a literal path like code/permissive matches only itself,
    code/* groups every corpus in that namespace."""
    return [corpus for corpus in corpora if fnmatch.fnmatch(corpus["path"], pattern)]


def catalog(corpora):
    """Repos across `corpora` (index list entries) by lowercased language,
    plus their combined totals. A single entry is today's plain per-corpus
    menu; several are merged by `waldo index bom`, in one process rather
    than one per corpus, which also dedupes any repo two corpora both
    happen to carry."""
    # Manifest files, not corpus paths: bom walks a bare corpus path's whole
    # subtree, which would silently fold in a nested corpus like
    # code/permissive/linux-core alongside code/permissive.
    bom = waldo_json("index", "bom", *(corpus["manifest"] for corpus in corpora))
    languages = collections.defaultdict(set)
    repo_count = 0
    for manifest in bom["manifests"]:
        for source in manifest["sources"]:
            # Case-folded: the index carries both "Shell" and "shell".
            for language in source.get("content", {}).get("programming_languages", []):
                languages[language.lower()].add(source["name"])
        repo_count += len(manifest["sources"])
    return languages, bom["totals"]["tokens"], repo_count


def prompt(cwd):
    """user@host:~/path style prefix, matching a real shell prompt."""
    user = os.environ.get("USER") or getpass.getuser()
    host = socket.gethostname().split(".")[0]
    home = str(Path.home())
    here = str(Path(cwd).resolve())
    if here == home:
        path = "~"
    elif here.startswith(home + os.sep):
        path = "~" + here[len(home):]
    else:
        path = here
    return f"{user}@{host}:{path}>"


def ask(flag, hint):
    """Prompts once for a flag the user left off the command line, printing
    `hint` (examples, not a default) first. Exits with a clear error rather
    than silently picking a value if there's no terminal to answer on (piped
    stdin, CI, ...) or the answer is blank -- every waldito flag is a real
    choice, not something to guess at."""
    print(hint)
    try:
        answer = input(f"{flag}: ").strip()
    except EOFError:
        answer = ""
    if not answer:
        # A non-terminal stdin echoes nothing back, typed or not; force the
        # error onto its own line rather than running into the prompt text.
        print()
        print(f"{flag} is required; no terminal to prompt on, or nothing entered", file=sys.stderr)
        sys.exit(1)
    return answer


def show_command(argv, cwd=REPO_ROOT):
    # Prefix colored like a shell prompt; the command stays default, since it's the real output.
    # shlex.quote: this runs via subprocess, no shell involved, so argv needs no quoting to
    # execute -- but a copy-pasted "<template>" hits bash's redirection operator unquoted.
    print(f"{COMMAND_COLOR}{prompt(cwd)}{RESET_COLOR} {shlex.join(argv)}")


def run(argv, cwd=REPO_ROOT, env=None):
    """Prints the command, streams output live, raises on non-zero exit."""
    show_command(argv, cwd)
    subprocess.run(argv, cwd=cwd, env=env, check=True)


def run_waldo(*args):
    run([WALDO_BIN, *args])


def waldo_json(*args):
    # check=True: a failure raises instead of silently reading as "no models yet".
    # stderr stays inherited so waldo's own error reaches the terminal.
    argv = [WALDO_BIN, "--json", *args]
    show_command(argv)
    result = subprocess.run(argv, cwd=REPO_ROOT, stdout=subprocess.PIPE, text=True, check=True)
    return json.loads(result.stdout) if result.stdout.strip() else []


def cmd_new(args):
    path = compose_path(args.topic)
    if path.exists() and not args.force:
        # Printed here, not via sys.exit(str): that only prints once SystemExit
        # reaches main()'s finally block, which would print "finished" first.
        print(f"{path} already exists; pass --force to overwrite", file=sys.stderr)
        sys.exit(1)
    if args.corpus is None:
        args.corpus = ask("--corpus", "An index corpus path or glob -- e.g. code/permissive, or code/* "
                                       "for every corpus in that namespace. `waldito catalog` lists what's there.")
    if args.size is None:
        sizes = "\n".join(f"  {name} (hidden_size={values[1]}, context_tokens={values[0]})" for name, values in SIZES.items())
        args.size = ask("--size", f"Model size:\n{sizes}")
    if args.size not in SIZES:
        print(f"--size must be one of {', '.join(SIZES)}", file=sys.stderr)
        sys.exit(1)
    if args.epochs is None:
        args.epochs = ask("--epochs", "Passes over the same tokens -- e.g. 1 (train once), "
                                       "or more to revisit already-seen tokens for a small corpus.")
    try:
        args.epochs = int(args.epochs)
    except ValueError:
        print("--epochs must be an integer", file=sys.stderr)
        sys.exit(1)
    if args.epochs < 1:
        print("--epochs must be 1 or more", file=sys.stderr)
        sys.exit(1)
    context_tokens, hidden_size, intermediate_size, layers, attention_heads, key_value_heads, batch_size = SIZES[args.size]
    # A glob, same as `waldito catalog --corpus`: code/* pulls in every code/*
    # corpus as its own weighted entry below, not just one literal path.
    corpora = waldo_json("index", "list")["corpora"]
    matches = matching_corpora(corpora, args.corpus)
    if not matches:
        print(f"no corpora match {args.corpus!r}; `waldito catalog` lists what is there", file=sys.stderr)
        sys.exit(1)
    matches = sorted(matches, key=lambda corpus: corpus["path"])
    # --repos stays alongside --lang: index language tags don't always match the
    # name (vuejs/vue is tagged TypeScript), so --lang alone can't reach every repo.
    repos = [repo.strip() for repo in args.repos.split(",") if repo.strip()]
    if args.lang:
        languages, _, _ = catalog(matches)
        # Comma-separated, because one language is rarely the whole topic.
        wanted = [name.strip().lower() for name in args.lang.split(",") if name.strip()]
        missing = [name for name in wanted if name not in languages]
        if missing:
            print(f"no {', '.join(missing)} repos in {args.corpus}; "
                  f"`waldito catalog {args.corpus} --code` lists what is there", file=sys.stderr)
            sys.exit(1)
        # Deduplicated: a repo declaring both typescript and vue is one repo.
        repos = sorted(set(repos) | {repo for name in wanted for repo in languages[name]})
        print(f"{len(repos)} repo{'' if len(repos) == 1 else 's'} from {', '.join(wanted)}")
    sources_block = ""
    if repos:
        # Quoted: an unquoted " #" would truncate as a YAML comment, and a
        # leading *, &, [ or { is alias/anchor/flow syntax rather than text.
        repo_lines = "\n".join(f'          - "{repo}"' for repo in repos)
        sources_block = SOURCES_BLOCK_TEMPLATE.format(repo_lines=repo_lines)
    # Equal weight across every matched corpus -- a starting point, not a
    # recommendation; hand-edit weight for an intentional mixture.
    corpora_block = "\n".join(
        f'      - path: "{corpus["path"]}"\n        weight: 1' for corpus in matches
    )
    compose = COMPOSE_TEMPLATE.format(
        topic=args.topic, context_tokens=context_tokens, hidden_size=hidden_size,
        intermediate_size=intermediate_size, layers=layers, attention_heads=attention_heads,
        key_value_heads=key_value_heads, sources_block=sources_block, corpora_block=corpora_block,
        batch_size=batch_size, vocabulary_size=VOCABULARY_SIZE, epochs=args.epochs, **TRAINING_DEFAULTS,
    )
    WALDITO_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(compose)
    print(f"wrote {path}")


def print_corpus_table(corpora):
    """CORPUS/SOURCES/TOKENS, straight off index list entries -- no manifest
    fetch needed. A Total row closes it out when there's more than one to sum;
    for a single corpus it would just repeat that one row."""
    print(f"{'CORPUS':<36}{'SOURCES':>8}{'TOKENS':>10}")
    corpora = sorted(corpora, key=lambda corpus: corpus["path"])
    for entry in corpora:
        print(f"{entry['path']:<36}{entry.get('sources', 0):>8}{entry.get('tokens', 0) / 1e9:>9.2f}B")
    if len(corpora) > 1:
        total_sources = sum(entry.get("sources", 0) for entry in corpora)
        total_tokens = sum(entry.get("tokens", 0) for entry in corpora)
        print(f"{'TOTAL':<36}{total_sources:>8}{total_tokens / 1e9:>9.2f}B")


def cmd_catalog(args):
    """`corpus` narrows which corpora are in play (everything, if omitted).
    Default: list them. --code: summarize them by programming language
    instead -- every code-tagged corpus, if `corpus` was omitted -- or with
    --lang, just the repos tagged with it."""
    corpora = waldo_json("index", "list")["corpora"]
    if args.corpus:
        matches = matching_corpora(corpora, args.corpus)
        if not matches:
            print(f"no corpora match {args.corpus!r}; `waldito catalog` lists what is there", file=sys.stderr)
            sys.exit(1)
    elif args.code:
        matches = code_corpora(corpora)
    else:
        matches = corpora
    if not matches:
        print("no matching corpora in the index", file=sys.stderr)
        sys.exit(1)
    if not args.code:
        print_corpus_table(matches)
        return
    if len(matches) == 1:
        label = matches[0]["path"]
    elif args.corpus:
        label = f"{len(matches)} corpora matching {args.corpus!r}"
    else:
        label = f"{len(matches)} corpora"
    languages, _, _ = catalog(sorted(matches, key=lambda corpus: corpus["path"]))
    print()
    if args.lang:
        # Comma-separated, because plenty of projects mix languages
        # (a Python backend with a TypeScript frontend, say).
        wanted = [name.strip().lower() for name in args.lang.split(",") if name.strip()]
        missing = [name for name in wanted if name not in languages]
        if missing:
            print(f"no {', '.join(missing)} repos in {label}", file=sys.stderr)
            sys.exit(1)
        # Grouped by language and sorted, same as the LANGUAGE/REPOS summary --
        # a repo tagged with more than one of `wanted` reappears in each of
        # its groups, since it does belong to all of them.
        for index, name in enumerate(sorted(wanted, key=lambda name: -len(languages[name]))):
            if index:
                print()
            print(f"{name} ({len(languages[name])})")
            for repo in sorted(languages[name]):
                print(f"  {repo}")
        return
    print_corpus_table(matches)
    if not languages:
        # No content.programming_languages tags to break down by -- true of
        # every non-code catalog (caselaw, mailing lists, ...).
        return
    print()
    print(f"{'LANGUAGE':<16}{'REPOS':>6}")
    for language, repos in sorted(languages.items(), key=lambda item: -len(item[1])):
        print(f"{language:<16}{len(repos):>6}")


def cmd_train(args):
    throttle = os.environ.get("WALDO_GPU_THROTTLE")
    if throttle:
        print(f"WALDO_GPU_THROTTLE={throttle} (GPU will idle between steps to hold roughly that duty cycle)")
    name, compose = model_name(args.topic), compose_path(args.topic)
    if not compose.exists():
        print(f"{compose} does not exist; run `waldito new {args.topic}` first", file=sys.stderr)
        sys.exit(1)
    # Mitigates the macOS Metal watchdog killing MLX training with
    # kIOGPUCommandBufferCallbackErrorImpactingInteractivity when the display is
    # active (ml-explore/mlx#3267, wontfix -- an Apple-side limit). Undocumented,
    # reported to help; harmless elsewhere. Still dying with that error? Close the lid.
    env = {**os.environ, "AGX_RELAX_CDM_CTXSTORE_TIMEOUT": "1"}
    run([WALDO_BIN, "model", "train", name, str(compose)], env=env)
    # Runs straight through rather than just printing the suggestion, so there's
    # nothing to copy-paste. Compare the held-out loss above to ln(259)=5.56,
    # the random-guess baseline for this vocabulary.
    print()
    run([WALDO_BIN, "model", "chat", name, "<template>", "--max-tokens", "800"])


def cmd_export(args):
    name, out = model_name(args.topic), export_dir(args.topic)
    # Always an incomplete EU GPAI draft -- a local waldito model is never placed on the EU market.
    run_waldo("model", "export", name, str(out), "--format", "ollama", "--allow-incomplete")
    run(["ollama", "create", name, "-f", "Modelfile"], cwd=out)


def cmd_delete(args):
    """Removes waldito-<topic> and any stale staged compose transaction, so the
    next new/train starts fresh instead of hitting "unfinished compose"."""
    name = model_name(args.topic)
    # waldo model rm has no confirmation of its own and takes every GPU-hour
    # trained with it. Same [y/N] wording as waldo's own confirmations (advisor.go).
    try:
        answer = input(f"waldito: delete {name} and all of its training? [y/N] ").strip().lower()
    except EOFError:
        answer = ""  # no terminal to confirm on (piped stdin) is not a yes
    if answer not in ("y", "yes"):
        print("cancelled")
        return
    argv = [WALDO_BIN, "model", "rm", name]
    show_command(argv)
    result = subprocess.run(argv, cwd=REPO_ROOT, capture_output=True, text=True)
    # Idempotent like rm -f: nothing to remove isn't worth showing, since waldo's
    # "no such model" otherwise surfaces as a raw MODEL.json-not-found error.
    if result.returncode == 0 and result.stdout.strip():
        print(result.stdout.strip())
    staging = Path.home() / ".waldo" / "models" / ".waldo-compose"
    if not staging.is_dir():
        return
    for transaction_dir in staging.iterdir():
        compose_json = transaction_dir / "COMPOSE.json"
        try:
            staged = json.loads(compose_json.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if staged.get("name") == name:
            shutil.rmtree(transaction_dir)
            print(f"removed stale compose transaction {transaction_dir.name}")


def cmd_status(args):
    models = waldo_json("model", "list")
    if args.topic:
        models = [entry for entry in models if entry.get("name") == model_name(args.topic)]
    else:
        models = [entry for entry in models if entry.get("name", "").startswith("waldito-")]
    if not models:
        print("no waldito models yet -- try `waldito new <topic> ...`")
        return
    for entry in models:
        # No state key at all means architecture created, nothing trained yet.
        state = entry.get("state", "no runs yet")
        print(f"{entry['name']:<28} {state:<12} {entry.get('approximate_parameters', '?')}")


def main():
    # Without this, print() fully buffers when stdout isn't a TTY, so our
    # messages can appear out of order against subprocess output.
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(prog="waldito", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    catalog_parser = sub.add_parser("catalog", help="corpora in the index, and what they can train on")
    catalog_parser.add_argument("corpus", nargs="?", help="an index corpus path or glob (e.g. code/*); omit for the whole index")
    catalog_parser.add_argument("--code", action="store_true", help="summarize by programming language instead of listing corpora")
    catalog_parser.add_argument("--lang", help="with --code, list only repos tagged with any of these comma-separated languages")
    catalog_parser.set_defaults(func=cmd_catalog)

    new = sub.add_parser("new", help="generate waldito-<topic>.yaml")
    new.add_argument("topic")
    new.add_argument("--corpus", help="an index corpus path or glob (e.g. code/*); omit to be prompted -- `waldito catalog` shows what's there")
    new.add_argument("--lang", default="", help="comma-separated catalog languages; takes every repo of each")
    new.add_argument("--repos", default="", help="comma-separated source repos, named exactly; combines with --lang")
    new.add_argument("--size", choices=list(SIZES), help="omit to be prompted")
    new.add_argument("--epochs", type=int, help="passes over the same tokens; each extra pass buys less than the last; omit to be prompted")
    new.add_argument("--force", action="store_true")
    new.set_defaults(func=cmd_new)

    train = sub.add_parser("train", help="train waldito-<topic>")
    train.add_argument("topic")
    train.set_defaults(func=cmd_train)

    export = sub.add_parser("export", help="export waldito-<topic> to Ollama")
    export.add_argument("topic")
    export.set_defaults(func=cmd_export)

    delete = sub.add_parser("delete", help="delete waldito-<topic>, its training, and any stale compose transaction")
    delete.add_argument("topic")
    delete.set_defaults(func=cmd_delete)

    status = sub.add_parser("status", help="list waldito models and their state")
    status.add_argument("topic", nargs="?")
    status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    # "starting"/"finished" are both 8 chars, so the colons and timestamps line up.
    started = datetime.now(timezone.utc)
    print(f"{FRAME_COLOR}waldito starting: {started:%Y-%m-%d %H:%M:%S} UTC{RESET_COLOR}")
    try:
        # Building bin/waldo is a separate step (`go build -o bin/waldo
        # ./cmd/waldo`), not waldito's job -- it just expects the result.
        if not (REPO_ROOT / WALDO_BIN).exists():
            print(f"{WALDO_BIN} does not exist; run `go build -o {WALDO_BIN} ./cmd/waldo` first", file=sys.stderr)
            sys.exit(1)
        args.func(args)
    except KeyboardInterrupt:
        # waldo already reports the clean interruption (retained transaction, resume hint).
        print()
        sys.exit(130)
    except FileNotFoundError as error:
        # go/ollama are external; missing one raises here instead of a traceback.
        print(f"{error.filename} is not installed or not on PATH", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    finally:
        # Runs regardless of how main() exits. Duration reuses the same two
        # timestamps being printed, so it can't disagree with them.
        finished = datetime.now(timezone.utc)
        elapsed = format_duration((finished - started).total_seconds())
        print(f"{FRAME_COLOR}waldito finished: {finished:%Y-%m-%d %H:%M:%S} UTC ({elapsed}){RESET_COLOR}")


if __name__ == "__main__":
    main()
