#!/usr/bin/env python3
"""waldito -- generate and drive tiny, Ollama-exportable openwaldo domain models.

Each domain gets a fixed name, waldito-<domain>, and a generated compose,
waldito-<domain>.yaml. Architecture sizes are WALDO's own byte-tokenizer
preset ladder (internal/model/presets.go: 10m/35m/90m), not invented here.

Byte tokenizer, not subword: GGUF export only emits byte@builtin-byte-schema-1
today (internal/modelexport/gguf.go), so it's the only vocabulary that reaches
Ollama. ADR 0046 already calls byte-level inferior to subword for real
quality -- this is a workaround for a current export gap, not a recommendation.

    waldito new typescript --repos react/react,vuejs/vue
    waldito train typescript
    waldito export typescript
    waldito status
"""
import argparse
import getpass
import json
import os
import shutil
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
WALDO_BIN = REPO_ROOT / "bin" / "waldo"

# Generated composes and exports live under WALDO's own durable directory
# (alongside ~/.waldo/models, ~/.waldo/index), not in the repo tree -- so
# they never show up in `git status` and never need a .gitignore entry.
WALDITO_DIR = Path.home() / ".waldo" / "waldito"

COMMAND_COLOR = "\033[1;36m"  # bold cyan, distinct from waldo's own output
RESET_COLOR = "\033[0m"

# name -> (context_tokens, hidden_size, intermediate_size, layers, attention_heads,
#          key_value_heads, batch_size), matching internal/model/presets.go exactly.
SIZES = {
    "10m": (512, 384, 1024, 6, 6, 2, 32),
    "35m": (1024, 512, 1408, 12, 8, 2, 16),
    "90m": (2048, 768, 2048, 12, 12, 4, 8),
}

# Not exposed on the command line: this is the whole tuning surface a
# generated compose starts from. Hand-edit the generated .yaml directly for
# anything beyond --corpus/--repos/--size; it's a plain, ordinary compose
# file. May become size- or corpus-dependent later.
#
# warmup_steps/checkpoint_every/evaluate_every are deliberately absent from
# the compose entirely, not defaulted here: epochs: 1 means the real step
# count isn't known until training preflight, and a fixed guess (previously
# warmup_steps: 200) fails outright on a small enough corpus ("warmup_steps
# must be in 0..steps"). Omitted, WALDO's own resolver computes
# min(100, steps/10) and min(500, steps) after the real count is known
# (internal/training/profile.go), which can't ever be out of range.
TRAINING_DEFAULTS = {
    "seed": 7,
    "learning_rate": 0.0003,
}

COMPOSE_TEMPLATE = """\
# Waldito: tiny, locally-runnable openwaldo domain model. Generated by
# `./waldito new {domain}` -- see docs/MODEL-COMPOSE.md for the schema.
#
# Byte tokenizer, not subword: this is the only vocabulary GGUF export can
# reach Ollama with today (internal/modelexport/gguf.go). ADR 0046 already
# calls byte-level inferior to subword for real quality -- a workaround for
# a current export gap, not a permanent design choice.
kind: waldo-model-compose
schema: 1
interaction:
  template: user-assistant-v1
architecture:
  family: decoder-transformer
  context_tokens: {context_tokens}
  vocabulary_size: 259
  hidden_size: {hidden_size}
  intermediate_size: {intermediate_size}
  layers: {layers}
  attention_heads: {attention_heads}
  key_value_heads: {key_value_heads}
  tie_embeddings: true
  parameter_dtype: bfloat16
  tokenizer:
    name: byte
    revision: builtin-byte-schema-1
stages:
  - name: pretrain
    type: pre-training
    objective: causal-language-modeling
    filter:
      main_content: true
      exclude:
        repetitive_content: true
        boilerplate_content: true
{sources_block}    corpora:
      - path: "{corpus}"
        weight: 1
    parameters:
      # epochs: 1, not a guessed tokens: budget -- WALDO scans the real
      # corpus at preflight and derives the exact step count (ADR 0059), so
      # this can't fail from a budget bigger than the corpus can supply.
      profile: causal-pretrain-weighted
      epochs: 1
      batch_size: {batch_size}
      sequence_length: {context_tokens}
      learning_rate: {learning_rate}
      seed: {seed}
      weight_decay: 0.1
      shuffle_buffer_records: 65536
      shuffle_buffer_bytes: 2147483648
      evaluation_max_records: 1024
      evaluation_max_bytes: 33554432
"""

SOURCES_BLOCK_TEMPLATE = """\
      sources:
        include:
{repo_lines}
"""


def model_name(domain):
    return f"waldito-{domain}"


def compose_path(domain):
    return WALDITO_DIR / f"waldito-{domain}.yaml"


def export_dir(domain):
    return WALDITO_DIR / "export" / f"{model_name(domain)}-ollama"


def format_duration(seconds):
    """Clone of waldo's own compactDuration (internal/cli/model.go), so a
    waldito duration reads exactly like a waldo one."""
    seconds = int(seconds)
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


def prompt(cwd):
    """user@host:~/path style prefix, matching a real shell prompt."""
    user = os.environ.get("USER") or getpass.getuser()
    host = socket.gethostname().split(".")[0]
    home = str(Path.home())
    here = str(Path(cwd).resolve())
    if here == home:
        path = "~"
    elif here.startswith(home + os.sep):
        path = "~" + here[len(home):]
    else:
        path = here
    return f"{user}@{host}:{path}>"


def show_command(argv, cwd=REPO_ROOT):
    # Prefix in color, like a shell prompt; the command itself in the
    # terminal's default color, since it's the actual output, not chrome.
    print(f"{COMMAND_COLOR}{prompt(cwd)}{RESET_COLOR} {' '.join(argv)}")


def run(argv, cwd=REPO_ROOT, env=None):
    """Prints the exact command, then streams to the terminal live; raises on
    a non-zero exit."""
    show_command(argv, cwd)
    subprocess.run(argv, cwd=cwd, env=env, check=True)


def build_waldo():
    run(["go", "build", "-o", str(WALDO_BIN), "./cmd/waldo"])


def run_waldo(*args):
    run([str(WALDO_BIN), *args])


def waldo_json(*args):
    # check=True so a failing waldo raises instead of returning nothing, which
    # would otherwise read as "no models yet". stderr is left inherited, so
    # waldo's own error reaches the terminal.
    argv = [str(WALDO_BIN), "--json", *args]
    show_command(argv)
    result = subprocess.run(argv, cwd=REPO_ROOT, stdout=subprocess.PIPE, text=True, check=True)
    return json.loads(result.stdout) if result.stdout.strip() else []


def cmd_new(args):
    path = compose_path(args.domain)
    if path.exists() and not args.force:
        # sys.exit(str) prints and exits only once SystemExit reaches the top
        # of the call stack -- after main()'s finally block already printed
        # the finish line, making that line appear before this message.
        # Printing here first keeps the terminal in true chronological order.
        print(f"{path} already exists; pass --force to overwrite", file=sys.stderr)
        sys.exit(1)
    context_tokens, hidden_size, intermediate_size, layers, attention_heads, key_value_heads, batch_size = SIZES[args.size]
    sources_block = ""
    if args.repos:
        # Quoted, like the corpus path below: an unquoted value containing
        # " #" would truncate as a YAML comment, and a leading *, &, [ or {
        # is alias/anchor/flow syntax rather than text.
        repo_lines = "\n".join(f'          - "{repo.strip()}"' for repo in args.repos.split(",") if repo.strip())
        sources_block = SOURCES_BLOCK_TEMPLATE.format(repo_lines=repo_lines)
    compose = COMPOSE_TEMPLATE.format(
        domain=args.domain, context_tokens=context_tokens, hidden_size=hidden_size,
        intermediate_size=intermediate_size, layers=layers, attention_heads=attention_heads,
        key_value_heads=key_value_heads, sources_block=sources_block, corpus=args.corpus,
        batch_size=batch_size, **TRAINING_DEFAULTS,
    )
    WALDITO_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(compose)
    print(f"wrote {path}")


def cmd_train(args):
    throttle = os.environ.get("WALDO_GPU_THROTTLE")
    if throttle:
        print(f"WALDO_GPU_THROTTLE={throttle} (GPU will idle between steps to hold roughly that duty cycle)")
    name, compose = model_name(args.domain), compose_path(args.domain)
    if not compose.exists():
        print(f"{compose} does not exist; run `waldito new {args.domain}` first", file=sys.stderr)
        sys.exit(1)
    # Mitigates the macOS Metal watchdog killing training with
    # kIOGPUCommandBufferCallbackErrorImpactingInteractivity: long MLX GPU
    # steps block WindowServer compositing, so the watchdog terminates the
    # run after a few minutes whenever the display is active
    # (ml-explore/mlx#3267, closed wontfix -- an Apple-side limit, not an MLX
    # bug). The variable is an undocumented Apple driver knob, reported to
    # help but not the workaround that issue itself gives (lid closed under
    # `caffeinate -s`); harmless on non-MLX backends. If training still dies
    # with that error, close the lid.
    env = {**os.environ, "AGX_RELAX_CDM_CTXSTORE_TIMEOUT": "1"}
    run([str(WALDO_BIN), "model", "train", name, str(compose)], env=env)


def cmd_export(args):
    name, out = model_name(args.domain), export_dir(args.domain)
    # Always an incomplete EU GPAI draft: a personal/local waldito model is
    # never placed on the EU market.
    run_waldo("model", "export", name, str(out), "--format", "ollama", "--allow-incomplete")
    run(["ollama", "create", name, "-f", "Modelfile"], cwd=out)


def cmd_delete(args):
    """Removes waldito-<domain> and any stale staged compose transaction for
    it, so a later `new`/`train` starts genuinely fresh instead of hitting
    "unfinished compose with different inputs"."""
    name = model_name(args.domain)
    # `waldo model rm` deletes the model directory outright with no prompt of
    # its own, taking every GPU-hour already trained into it. Same [y/N] and
    # same accepted answers as waldo's own confirmations (internal/cli/advisor.go).
    try:
        answer = input(f"waldito: delete {name} and all of its training? [y/N] ").strip().lower()
    except EOFError:
        answer = ""  # no terminal to confirm on (piped stdin) is not a yes
    if answer not in ("y", "yes"):
        print("cancelled")
        return
    argv = [str(WALDO_BIN), "model", "rm", name]
    show_command(argv)
    result = subprocess.run(argv, cwd=REPO_ROOT, capture_output=True, text=True)
    # Idempotent, like rm -f: nothing to remove is not an error worth
    # showing. waldo reports "no such model" as a raw MODEL.json-not-found
    # error, which would otherwise look like a real problem.
    if result.returncode == 0 and result.stdout.strip():
        print(result.stdout.strip())
    staging = Path.home() / ".waldo" / "models" / ".waldo-compose"
    if not staging.is_dir():
        return
    for transaction_dir in staging.iterdir():
        compose_json = transaction_dir / "COMPOSE.json"
        try:
            staged = json.loads(compose_json.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if staged.get("name") == name:
            shutil.rmtree(transaction_dir)
            print(f"removed stale compose transaction {transaction_dir.name}")


def cmd_status(args):
    models = waldo_json("model", "list")
    if args.domain:
        models = [entry for entry in models if entry.get("name") == model_name(args.domain)]
    else:
        models = [entry for entry in models if entry.get("name", "").startswith("waldito-")]
    if not models:
        print("no waldito models yet -- try `waldito new <domain> ...`")
        return
    for entry in models:
        # A model with no runs yet (architecture created, nothing trained)
        # has no state key at all.
        state = entry.get("state", "no runs yet")
        print(f"{entry['name']:<28} {state:<12} {entry.get('approximate_parameters', '?')}")


def main():
    # Without this, print() fully buffers whenever stdout isn't a TTY (piped,
    # redirected, logged), so our own messages can appear out of order
    # against subprocess output, which is inherited and unbuffered.
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(prog="waldito", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    new = sub.add_parser("new", help="generate waldito-<domain>.yaml")
    new.add_argument("domain")
    new.add_argument("--corpus", default="code/permissive")
    new.add_argument("--repos", default="", help="comma-separated source repos; omit to use the whole corpus")
    # Smallest preset by default: the point right now is a working pipeline
    # and a first inference-speed measurement, not model quality.
    new.add_argument("--size", choices=sorted(SIZES), default="10m")
    new.add_argument("--force", action="store_true")
    new.set_defaults(func=cmd_new)

    train = sub.add_parser("train", help="train waldito-<domain>")
    train.add_argument("domain")
    train.set_defaults(func=cmd_train)

    export = sub.add_parser("export", help="export waldito-<domain> to Ollama")
    export.add_argument("domain")
    export.set_defaults(func=cmd_export)

    delete = sub.add_parser("delete", help="delete waldito-<domain>, its training, and any stale compose transaction")
    delete.add_argument("domain")
    delete.set_defaults(func=cmd_delete)

    status = sub.add_parser("status", help="list waldito models and their state")
    status.add_argument("domain", nargs="?")
    status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    # "starting"/"finished" are both 8 characters, so the colons -- and the
    # timestamps after them -- line up in the terminal.
    started = datetime.now(timezone.utc)
    print(f"waldito starting: {started:%Y-%m-%d %H:%M:%S} UTC")
    try:
        # Once per invocation, not once per subcommand.
        build_waldo()
        args.func(args)
    except KeyboardInterrupt:
        # waldo itself already reports the clean interruption (retained
        # transaction, resume hint) on its way out; nothing to add here.
        print()
        sys.exit(130)
    except FileNotFoundError as error:
        # go and ollama are both external; a missing one raises here rather
        # than exiting non-zero, and a traceback would tell a novice nothing.
        print(f"{error.filename} is not installed or not on PATH", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    finally:
        # Runs on success, sys.exit() from anywhere above, KeyboardInterrupt,
        # and CalledProcessError alike -- a finally block is exception-type
        # agnostic, unlike the except clauses above it. Duration comes from
        # the same two timestamps being printed, not a separate clock, so it
        # can never visually disagree with what's shown alongside it.
        finished = datetime.now(timezone.utc)
        elapsed = format_duration((finished - started).total_seconds())
        print(f"waldito finished: {finished:%Y-%m-%d %H:%M:%S} UTC ({elapsed})")


if __name__ == "__main__":
    main()
